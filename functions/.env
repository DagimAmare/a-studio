# A Studio functions settings (not secret). The mail password is a secret:
#   firebase functions:secrets:set SMTP_PASS
# SMTP_HOST is asked for on the first deploy if it is not set here. Find it
# in cPanel > Email Accounts > brush@astudio.hepius.co > Connect Devices
# ("Outgoing Server"), and write it below, e.g. SMTP_HOST=mail.hepius.co
APP_URL=https://astudio.hepius.co
SMTP_PORT=465
SMTP_USER=brush@astudio.hepius.co
MAIL_FROM="A Studio <brush@astudio.hepius.co>"
MAIL_PER_RUN=40
